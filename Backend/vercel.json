{
    "version": 2,
    "builds": [
        { "src": "index.js", "use": "@vercel/node"}
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/"
        }
    ],
    "crons": [
        {
            "path": "/api/contact/jobs/close-day",
            "schedule": "0 19 * * *"
        }
    ]
}